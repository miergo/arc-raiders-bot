# Ollama local server
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Set to 1 to print tool call details during runs
VERBOSE_TOOL_CALLS=0

# RAG knowledge cache
CHROMA_DATA_DIR=data/chroma
EMBEDDING_MODEL=nomic-embed-text
CACHE_SIMILARITY_THRESHOLD=0.75

# MLflow tracing
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=arc-raiders-rag
